# cmake -DRUNNER=<vector_runner> -DDIR=<vectors folder> -DPREFIX=<set name prefix> -DCWD=<main folder> -P run_vector_sets.cmake
# Runs the runner on every <PREFIX>*.vec of the folder; fails on the first set that is not equal in every call.  "no vector files" when there is none (the test is then skipped).
cmake_minimum_required(VERSION 3.16)
file(GLOB sets "${DIR}/${PREFIX}*.vec")
list(LENGTH sets n)
if(n EQUAL 0)
  message("no vector files: ${DIR}/${PREFIX}*.vec (python -I tools/make_vectors.py)")
  return()
endif()
set(calls 0)
separate_arguments(ARGS UNIX_COMMAND "${RUNNER_ARGS}")
foreach(f ${sets})
  get_filename_component(nm "${f}" NAME)
  execute_process(COMMAND ${RUNNER} ${ARGS} resources/vectors/${nm} WORKING_DIRECTORY ${CWD} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(STRIP "${out}" out)
  message("${out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${nm}: runner exit code ${rc}\n${err}")
  endif()
endforeach()
message("${n} sets, all calls equal")
