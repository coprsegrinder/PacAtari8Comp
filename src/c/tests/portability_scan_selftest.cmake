# Self test of portability_scan.cmake: cmake -DSCAN=<scan script> -DWORK=<folder> -P portability_scan_selftest.cmake
# Every "bad" snippet must make the scan fail and name the right finding; every "good" snippet must pass.
cmake_minimum_required(VERSION 3.16)
file(MAKE_DIRECTORY "${WORK}")

function(run_scan label text expect_fail expect_text)
  file(WRITE "${WORK}/probe.c" "${text}")
  execute_process(COMMAND ${CMAKE_COMMAND} -DSCAN_FILE=${WORK}/probe.c -P ${SCAN}
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(all "${out}${err}")
  if(expect_fail)
    if(rc EQUAL 0)
      message(FATAL_ERROR "self test: '${label}' was NOT caught")
    endif()
    if(NOT all MATCHES "${expect_text}")
      message(FATAL_ERROR "self test: '${label}' failed for another reason: ${all}")
    endif()
  else()
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "self test: '${label}' was wrongly refused: ${all}")
    endif()
  endif()
endfunction()

run_scan("system header windows.h" "#include <windows.h>\nint x;\n" TRUE "system header")
run_scan("system header unistd.h" "#include <unistd.h>\nint x;\n" TRUE "system header")
run_scan("system header sys/stat.h" "#include <sys/stat.h>\nint x;\n" TRUE "system header")
run_scan("attribute" "int f(void) __attribute__((noreturn));\n" TRUE "attribute")
run_scan("pragma" "#pragma pack(1)\nint x;\n" TRUE "attribute")
run_scan("inline asm" "void f(void) { __asm__ volatile (\"nop\"); }\n" TRUE "assembly")
run_scan("non-standard type" "typedef unsigned char u8;\nu8 x;\n" TRUE "non-standard type")
run_scan("DWORD" "DWORD x;\n" TRUE "non-standard type")
run_scan("fopen" "void f(void) { FILE *p = fopen(\"x\", \"rb\"); (void)p; }\n" TRUE "fopen")
run_scan("remove" "void f(void) { remove(\"x\"); }\n" TRUE "remove")
run_scan("getenv" "void f(void) { (void)getenv(\"TEMP\"); }\n" TRUE "getenv")
run_scan("system" "void f(void) { system(\"dir\"); }\n" TRUE "system")
run_scan("tmpfile" "void f(void) { tmpfile(); }\n" TRUE "tmpfile")
run_scan("standard headers and the words in comments and strings" "#include <stdint.h>\n#include <string.h>\n/* fopen( is a function, __attribute__ and DWORD x too */\nstatic const char *s = \"fopen( remove( system(\";\nint add(int a, int b) { return a + b; }\n" FALSE "")
run_scan("a name that merely contains a forbidden one" "int my_fopen_count(void);\nint reopen(void);\nint z = 0;\n" FALSE "")
message("portability scan self test: all probes behaved")
