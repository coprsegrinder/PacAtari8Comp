# Altirra debugger commands: an INPUT EXERCISER - every input the game reads gets every kind of value once, in the real game (stage 57, docs/33-input-output.md).
# Title (state 3, frame counter t1 = frames since the title menu appeared): CONSOL held for 9 frames at the controller reads $A507 / $A514 / $A51C (the values the game gets, as in altirra_pregame.cmd):
#   t1 80 OPTION ($03), 130 SELECT ($05), 180 SELECT+START ($04), 230 OPTION+SELECT ($01), 280 OPTION+START ($02), 330 all three ($00); SELECT again at 355 (two players -> one player), then the TRIGGER STRIG0 = 0 from t1 400 for 10 frames starts the game ($A4FA).
# Play (frame counter t8 since the start): STICK0 gets the four directions in turn (every 48 frames; 0E up, 0D down, 0B left, 07 right) and two diagonals (0A, 06) and 0F (nothing); CH := $21 (space bar) at t8 300 and 500 pauses and resumes.
# TEST AIDS (emulated machine only): Pac-Man cannot die ($A923 skipped).  Everything else the game decides.
# The same harness with STRIG1 ($0285, read at $A4FF) instead of STRIG0 is altirra_inputs1.cmd (generated by sed from this file).
# Run:  powershell -File tools\run_patrol_trace.ps1 -Log analysis\raw-logs\inputs.txt -Seconds 40 -Cmd altirra_inputs.cmd
r @t1 0
r @t3 0
r @t7 0
r @t8 0
bp -n a923 "r pc $a936"
bp -n a537 "r @t7 @t7+1"
bp -n a5fd "r @t1 (db($19)>=3)*(@t7=0)*(@t1+1)"
bp -n a5fd "r @t8 (@t7>0)*(@t8+1)"
bp -n a5fd "r @t3 ((@t1>=80)&(@t1<=88))*4+((@t1>=130)&(@t1<=138))*2+((@t1>=180)&(@t1<=188))*3+((@t1>=230)&(@t1<=238))*6+((@t1>=280)&(@t1<=288))*5+((@t1>=330)&(@t1<=338))*7+((@t1>=355)&(@t1<=363))*2"
bp -n a507 "r a 7-@t3"
bp -n a514 "r a 7-@t3"
bp -n a51c "r a 6+(@t3>0)"
bp -n a4fa "eb $284 1-((@t1>=400)&(@t1<=410))"
bp -n a4ff "eb $285 1"
bp -n a82f "r @t5 ((@t8/$30)%6); eb $278 ($0E*(@t5=0))+($0D*(@t5=1))+($0B*(@t5=2))+($07*(@t5=3))+($0A*(@t5=4))+($06*(@t5=5))"
bp -n a5fd "r @t6 ((@t8=300)|(@t8=500)); eb $2fc $21*@t6+db($2fc)*(1-@t6)"
bt a386 "SENT f=%d pc=$%04X" @frame pc
bt a537 "NEW_GAME f=%d t1=%d" @frame @t1
bt a4e2 "KEY_TOGGLE f=%d new=%d" @frame @a
